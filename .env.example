# ── MLflow ────────────────────────────────────────────────────────────────────
# Override the default SQLite tracking URI if you use a remote MLflow server.
# MLFLOW_TRACKING_URI=http://your-mlflow-server:5000

# ── API ───────────────────────────────────────────────────────────────────────
# Port the API listens on (default: 8000)
# PORT=8000

# ── Paths ─────────────────────────────────────────────────────────────────────
# All paths default to paths relative to the project root.
# Override here if your data / model directories live elsewhere.
# DATA_DIR=data
# MODELS_DIR=models
